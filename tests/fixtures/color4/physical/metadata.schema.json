{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvtp.invalid/schemas/color4-physical-capture-v1.json",
  "title": "CVTP COLOR_4 physical camera capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "provenance",
    "rawFrame",
    "camera",
    "configuration",
    "oracle"
  ],
  "properties": {
    "$schema": { "const": "../metadata.schema.json" },
    "schema": { "const": "cvtp-color4-physical-capture" },
    "version": { "const": 1 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "rawFrame": { "$ref": "#/$defs/rawFrame" },
    "camera": { "$ref": "#/$defs/camera" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "oracle": { "$ref": "#/$defs/oracle" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "rawFrame": {
            "type": "object",
            "properties": { "scope": { "const": "limited-evidence" } },
            "required": ["scope"]
          }
        },
        "required": ["rawFrame"]
      },
      "then": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": {
            "oracle": {
              "type": "object",
              "properties": {
                "vision": {
                  "type": "object",
                  "properties": {
                    "reason": { "const": "CANDIDATE_BUDGET_EXCEEDED" }
                  },
                  "required": ["reason"]
                }
              },
              "required": ["vision"]
            }
          },
          "required": ["oracle"]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "oracle": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "object",
                "properties": { "kind": { "const": "crc-derived-regression" } },
                "required": ["kind"]
              }
            },
            "required": ["basis"]
          }
        },
        "required": ["oracle"]
      },
      "then": {
        "type": "object",
        "properties": {
          "oracle": {
            "type": "object",
            "required": ["vision", "classifier", "unwrap"],
            "properties": {
              "vision": { "$ref": "#/$defs/visionValid" },
              "classifier": { "$ref": "#/$defs/classifierValid" },
              "unwrap": { "$ref": "#/$defs/unwrapValid" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracleBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "enum": ["crc-derived-regression", "independent-tx-ground-truth"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "erasureDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "byShard"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "byShard": {
          "type": "array",
          "description": "Replay validation enforces profile length and total=sum(byShard).",
          "minItems": 6,
          "maxItems": 14,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "classifierDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "p50", "p95", "max"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "min": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "device", "browser"],
      "properties": {
        "kind": { "const": "physical-camera" },
        "device": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "rawFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "pngSha256", "rgbaSha256", "preparation", "scope"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "pngSha256": { "$ref": "#/$defs/sha256" },
        "rgbaSha256": { "$ref": "#/$defs/sha256" },
        "preparation": {
          "enum": ["unaltered-export", "privacy-crop", "privacy-redacted"]
        },
        "scope": {
          "description": "Only full-camera-frame supports whole-acquisition and candidate-budget claims.",
          "enum": ["full-camera-frame", "limited-evidence"]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "preparation": { "const": "unaltered-export" } }
          },
          "then": {
            "type": "object",
            "properties": { "scope": { "const": "full-camera-frame" } }
          },
          "else": {
            "type": "object",
            "properties": { "scope": { "const": "limited-evidence" } }
          }
        }
      ]
    },
    "captureSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frameRate"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "actual", "distanceM", "angleDeg"],
      "properties": {
        "requested": { "$ref": "#/$defs/captureSettings" },
        "actual": { "$ref": "#/$defs/captureSettings" },
        "distanceM": { "type": "number", "minimum": 0 },
        "angleDeg": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "expectedProfile",
        "palette",
        "paletteId",
        "txFps",
        "prefilterMode",
        "brightness",
        "canonicalScale",
        "maxDetectionDimension"
      ],
      "properties": {
        "carrier": { "const": "COLOR_4" },
        "expectedProfile": { "enum": ["ROBUST", "EXPERIMENTAL"] },
        "palette": { "enum": ["KCMY", "KRGB"] },
        "paletteId": { "enum": [0, 1] },
        "txFps": { "enum": [1, 2, 5, 10] },
        "prefilterMode": { "enum": ["observe", "enabled"] },
        "brightness": { "enum": ["high", "maximum"] },
        "canonicalScale": { "enum": [4, 6, 8] },
        "maxDetectionDimension": { "enum": [960, 1280, "source"] }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "palette": { "const": "KCMY" } }
          },
          "then": {
            "type": "object",
            "properties": { "paletteId": { "const": 0 } }
          },
          "else": {
            "type": "object",
            "properties": { "paletteId": { "const": 1 } }
          }
        }
      ]
    },
    "visionValid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "valid" } }
    },
    "visionRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "rejected" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "classifierValid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile",
        "paletteId",
        "sequencePhase",
        "uncertainCells",
        "candidateErasures",
        "erasureCandidateScore",
        "codedBytesSha256"
      ],
      "properties": {
        "status": { "const": "valid" },
        "profile": { "enum": ["ROBUST", "EXPERIMENTAL"] },
        "paletteId": { "enum": [0, 1] },
        "sequencePhase": { "enum": [0, 1, 2, 3] },
        "uncertainCells": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "candidateErasures": { "$ref": "#/$defs/erasureDistribution" },
        "erasureCandidateScore": { "$ref": "#/$defs/classifierDistribution" },
        "codedBytesSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classifierRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "rejected" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "unwrapValid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sessionId",
        "sequence",
        "selectedPolicy",
        "selectedBudgetFraction",
        "selectedMaxErasuresPerShard",
        "attempts",
        "selectedErasures",
        "correctedErrors",
        "correctedBytes",
        "correctedShards",
        "innerFrameSha256"
      ],
      "properties": {
        "status": { "const": "valid" },
        "sessionId": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "selectedPolicy": { "enum": ["classifier-budgeted", "hard-decision"] },
        "selectedBudgetFraction": { "enum": [0, 0.5, 0.75, 1] },
        "selectedMaxErasuresPerShard": { "type": "integer", "minimum": 0, "maximum": 32 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 4 },
        "selectedErasures": { "$ref": "#/$defs/erasureDistribution" },
        "correctedErrors": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "correctedBytes": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "correctedShards": { "type": "integer", "minimum": 0, "maximum": 255 },
        "innerFrameSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "unwrapRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "rejected" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "publicReason", "internalReason", "diagnosticReason"],
      "properties": {
        "stage": {
          "enum": [
            "geometry",
            "bootstrap",
            "calibration",
            "classification",
            "rs",
            "crc",
            "wire"
          ]
        },
        "publicReason": { "type": "string", "minLength": 1 },
        "internalReason": { "type": "string", "minLength": 1 },
        "diagnosticReason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "oracle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "vision", "rejection"],
          "properties": {
            "basis": { "$ref": "#/$defs/oracleBasis" },
            "vision": { "$ref": "#/$defs/visionRejected" },
            "rejection": { "$ref": "#/$defs/rejection" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "vision", "classifier", "rejection"],
          "properties": {
            "basis": { "$ref": "#/$defs/oracleBasis" },
            "vision": { "$ref": "#/$defs/visionValid" },
            "classifier": { "$ref": "#/$defs/classifierRejected" },
            "rejection": { "$ref": "#/$defs/rejection" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "vision", "classifier", "unwrap"],
          "properties": {
            "basis": { "$ref": "#/$defs/oracleBasis" },
            "vision": { "$ref": "#/$defs/visionValid" },
            "classifier": { "$ref": "#/$defs/classifierValid" },
            "unwrap": { "$ref": "#/$defs/unwrapValid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "vision", "classifier", "unwrap", "rejection"],
          "properties": {
            "basis": { "$ref": "#/$defs/oracleBasis" },
            "vision": { "$ref": "#/$defs/visionValid" },
            "classifier": { "$ref": "#/$defs/classifierValid" },
            "unwrap": { "$ref": "#/$defs/unwrapRejected" },
            "rejection": { "$ref": "#/$defs/rejection" }
          }
        }
      ]
    }
  }
}
